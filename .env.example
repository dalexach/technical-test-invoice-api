# Copie este archivo a .env y ajuste los valores.
# .env esta en .gitignore: los secretos no se versionan.

# Contrasena del usuario sa del contenedor de SQL Server.
# Requisito de SQL Server: minimo 8 caracteres con mayusculas, minusculas,
# digitos y simbolos.
MSSQL_SA_PASSWORD=Wtw#Prueba2026!

# Cadena de conexion que usa la API.
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=InvoiceDb;User Id=sa;Password=Wtw#Prueba2026!;TrustServerCertificate=True;Encrypt=True;Max Pool Size=200;Connection Timeout=15;"

# Clave de firma de los tokens: minimo 32 caracteres.
Jwt__Key=cambie-esta-clave-por-una-cadena-aleatoria-de-32-caracteres-o-mas

# Credenciales aceptadas por POST /auth/token.
Jwt__Client__ClientId=wtw-demo-client
Jwt__Client__ClientSecret=cambie-este-secreto-antes-de-usar
